---
import Base from '../../layouts/Base.astro';
import Catalog from '../../components/Catalog.astro';
import { releasedTracks, upcomingTracks } from '../../lib/tracks';

const tracks = await releasedTracks();
const upcoming = await upcomingTracks();
---
<Base title="Catalog" description="Every release, filed with its full sequence.">
  <Catalog tracks={tracks} upcoming={upcoming} heading="The catalog" headingLevel="h1" />
</Base>
