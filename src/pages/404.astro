---
import Base from '../layouts/Base.astro';
---
<Base title="Not found">
  <section class="container section wrap">
    <svg class="sunset" viewBox="0 0 100 100" aria-hidden="true" shape-rendering="crispEdges">
      <rect width="100" height="100" fill="#F1E7D4" />
      <circle cx="50" cy="78" r="28" fill="#F0562A" shape-rendering="geometricPrecision" />
      <rect y="54" width="100" height="46" fill="#F1E7D4" />
      <rect y="55.84" width="100" height="3.68" fill="#13201B" /><rect y="64.58" width="100" height="3.68" fill="#13201B" />
      <rect y="73.32" width="100" height="3.68" fill="#13201B" /><rect y="82.06" width="100" height="3.68" fill="#13201B" />
      <rect y="90.8" width="100" height="9.2" fill="#13201B" />
    </svg>
    <h1>This specimen isn't in the catalog.</h1>
    <p class="links"><a href="/" class="btn btn-secondary">Home</a><a href="/course/" class="btn btn-primary">The free course →</a></p>
  </section>
</Base>

<style>
  .wrap { display: flex; flex-direction: column; gap: 28px; align-items: flex-start; }
  .sunset { width: 120px; border: var(--rule); }
  h1 { font-size: var(--fs-h2); letter-spacing: var(--tracking-h2); }
  .links { display: flex; flex-wrap: wrap; gap: 12px; }
</style>
