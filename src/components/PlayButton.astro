---
// Sends a track to the docked player. The DockedPlayer island handles clicks on [data-play]
// (one delegated listener) and keeps data-state, the label and the icon in sync.
interface Props {
  id: string; // catalogue number
  title: string;
  size?: number;
  variant?: 'circle' | 'bar' | 'primary';
  text?: string;
  class?: string;
}
const { id, title, size = 44, variant = 'circle', text = 'Play', class: cls } = Astro.props;
const icon = Math.round(size / 4);
const label = `Play ${title} (${id})`;
---
{variant === 'circle' ? (
  <button type="button" class:list={['play-circle', 'pb', cls]} data-play={id} data-state="idle" data-label-play={label} aria-label={label} style={`width:${size}px;height:${size}px`}>
    <svg class="i-play" width={icon} height={icon} viewBox="0 0 14 14" aria-hidden="true"><path d="M2 1l11 6-11 6z" fill="currentColor" /></svg>
    <svg class="i-pause" width={icon} height={icon} viewBox="0 0 12 12" aria-hidden="true"><rect x="1" y="1" width="3.5" height="10" fill="currentColor" /><rect x="7.5" y="1" width="3.5" height="10" fill="currentColor" /></svg>
  </button>
) : (
  <button type="button" class:list={['btn', 'pb', variant === 'primary' ? 'btn-primary' : 'btn-ink', cls]} data-play={id} data-state="idle" data-text-play={text}>
    <svg class="i-play" width="13" height="13" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 1l11 6-11 6z" fill="currentColor" /></svg>
    <svg class="i-pause" width="13" height="13" viewBox="0 0 12 12" aria-hidden="true"><rect x="1" y="1" width="3.5" height="10" fill="currentColor" /><rect x="7.5" y="1" width="3.5" height="10" fill="currentColor" /></svg>
    <span class="label">{text}</span>
  </button>
)}

<style>
  .pb .i-pause { display: none; }
  .pb[data-state='playing'] .i-play { display: none; }
  .pb[data-state='playing'] .i-pause { display: block; }
</style>
