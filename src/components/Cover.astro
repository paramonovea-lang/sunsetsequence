---
// Sunset cover drawn from track data (docs/04). Decorative by default: a title sits next to it.
import { coverSvg, type CoverInput } from '../lib/cover';

interface Props extends CoverInput {
  size?: number | string;
  label?: string; // set when the cover stands alone and needs alt text
  class?: string;
}
const { size, label, class: cls, ...input } = Astro.props;
const svg = coverSvg({ ...input, title: label });
const style = size ? `width:${typeof size === 'number' ? `${size}px` : size};` : '';
---
<span class:list={['cover', cls]} style={style} aria-hidden={label ? undefined : 'true'} set:html={svg} />

<style>
  .cover { display: block; aspect-ratio: 1 / 1; flex: none; line-height: 0; }
  .cover :global(svg) { width: 100%; height: 100%; }
</style>
