---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import StatsBanner from '../components/StatsBanner.astro';
import DockedPlayer from '../islands/DockedPlayer';
import { playerTrack, releasedTracks } from '../lib/tracks';
import { SITE } from '../site';
import fontSans from '../assets/fonts/SchibstedGrotesk-Variable.woff2?url';
import fontMono from '../assets/fonts/DMMono-Regular.woff2?url';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  footerStripesBg?: string;
  /** Social preview image (absolute or site path); defaults to design/icons/og-default.png. */
  image?: string;
}
const { title, description = 'Original music written in code, and a free live-coding course.', footerStripesBg, image = '/og-default.png' } = Astro.props;
const playerTracks = (await releasedTracks()).map(playerTrack);
const fullTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- favicons + manifest: design/icons/head-snippet.html -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name}: releases`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#13201B" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href={fontSans} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontMono} as="font" type="font/woff2" crossorigin />
    <ClientRouter />
    <Analytics />
    <script is:inline>
      // Play clicks that happen before the docked player has loaded are kept, not lost
      // (the player takes the last one when it starts; see islands/DockedPlayer.tsx).
      document.addEventListener('click', function (e) {
        var b = e.target && e.target.closest && e.target.closest('[data-play]');
        if (b && !window.__sqPlayerReady) { window.__sqPendingPlay = b.dataset.play; e.preventDefault(); }
      });
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <StatsBanner />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer stripesBg={footerStripesBg} />
    <DockedPlayer client:load transition:persist="player" tracks={playerTracks} artist={SITE.artist} />
    <script>
      import '../scripts/codeblocks';
      import '../scripts/course-progress';
      import '../scripts/scrollable';
    </script>
  </body>
</html>
